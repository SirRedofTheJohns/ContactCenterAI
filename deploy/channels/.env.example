CCAI_CHANNEL_META_ENDPOINT_ID=
CCAI_CHANNEL_META_ACCESS_TOKEN=
CCAI_CHANNEL_META_APP_SECRET=
CCAI_CHANNEL_META_VERIFY_TOKEN=
CCAI_CHANNEL_META_API_VERSION=
CCAI_CHANNEL_META_RECIPIENTS=
CCAI_CHANNEL_META_TEST_RESOURCES_CONFIRMED=false
