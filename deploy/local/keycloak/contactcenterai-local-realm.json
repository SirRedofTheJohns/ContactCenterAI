{
  "realm": "contactcenterai-local",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "Customer",
        "description": "Synthetic local portfolio role"
      },
      {
        "name": "Agent",
        "description": "Synthetic local portfolio role"
      },
      {
        "name": "Supervisor",
        "description": "Synthetic local portfolio role"
      },
      {
        "name": "KnowledgeEditor",
        "description": "Synthetic local portfolio role"
      },
      {
        "name": "KnowledgeReviewer",
        "description": "Synthetic local portfolio role"
      },
      {
        "name": "OperationsAdmin",
        "description": "Synthetic local portfolio role"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "ccai-roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "ccai_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "ccai_role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "contactcenterai-bff",
      "name": "Local BFF compatibility client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CCAI_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://localhost:7443/signin-oidc",
        "https://localhost:7451/signin-oidc",
        "http://127.0.0.1:7452/signin-oidc"
      ],
      "webOrigins": [
        "https://localhost:7443"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7443/signout-callback-oidc"
      },
      "defaultClientScopes": [
        "ccai-roles"
      ],
      "optionalClientScopes": []
    }
  ],
  "scopeMappings": [
    {
      "client": "contactcenterai-bff",
      "roles": [
        "Customer",
        "Agent",
        "Supervisor",
        "KnowledgeEditor",
        "KnowledgeReviewer",
        "OperationsAdmin"
      ]
    }
  ],
  "users": [
