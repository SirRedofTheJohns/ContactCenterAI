    "/v1/demo/profile": {
      "get": {
        "summary": "Public synthetic presentation mode; no identity/secrets",
        "security": [],
        "responses": {
          "200": {
            "description": "Selected mode/provider",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "providerId",
                    "factualAnswers",
                    "contactCenter",
                    "retrieval"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "simulated",
                        "local-llm"
                      ]
                    },
                    "providerId": {
                      "type": "string"
                    },
                    "factualAnswers": {
                      "type": "string",
                      "const": "governed-extracts-and-source-templates"
                    },
                    "contactCenter": {
                      "type": "string",
                      "const": "mock"
                    },
                    "retrieval": {
                      "type": "string",
                      "enum": [
                        "semantic-reranked-local",
                        "topic-fixture"
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Loopback/Host denied"
          }
        }
      }
    },
    "/v1/operations/status": {
      "get": {
        "summary": "Operational aggregates and bounded sanitized traces; OperationsAdmin only",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Server-authorized synthetic operational state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "operational",
                    "telemetry"
                  ],
                  "properties": {
                    "operational": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "commands",
                        "pendingTurns",
                        "knowledgeVariants",
                        "indexedVariants",
                        "semanticEnabled",
                        "alerts"
                      ],
                      "properties": {
                        "commands": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "pending",
                            "submitted",
                            "unknown",
                            "completed",
                            "rejected",
                            "conflict",
                            "humanReview"
                          ],
                          "properties": {
                            "pending": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "submitted": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "unknown": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "completed": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "rejected": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "conflict": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "humanReview": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "pendingTurns": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "knowledgeVariants": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "indexedVariants": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "semanticEnabled": {
                          "type": "boolean"
                        },
                        "alerts": {
                          "type": "array",
                          "maxItems": 3,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "telemetry": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "scope",
                        "total",
                        "failed",
                        "dropped",
                        "recent"
                      ],
                      "properties": {
                        "scope": {
                          "type": "string"
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "failed": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "dropped": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "recent": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "traceId",
                              "spanId",
                              "parentSpanId",
                              "operation",
                              "durationMs",
                              "httpStatus",
                              "language",
                              "finishedAt"
                            ],
                            "properties": {
                              "traceId": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{32}$"
                              },
                              "spanId": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{16}$"
                              },
                              "parentSpanId": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "operation": {
                                "type": "string",
                                "enum": [
                                  "api.request",
                                  "assistant.turn",
                                  "knowledge.search",
                                  "knowledge.rerank",
                                  "source.read",
                                  "source.cancel",
                                  "source.receipt"
                                ]
                              },
                              "durationMs": {
                                "type": "number",
                                "minimum": 0
                              },
                              "httpStatus": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "language": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "enum": [
                                  "es",
                                  "en",
                                  null
                                ]
                              },
                              "finishedAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Active session required"
          },
          "403": {
            "description": "OperationsAdmin role required"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId",
          "retryable"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "CreateConversation": {
        "type": "object",
        "required": [
          "language"
        ],
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          }
        }
      },
      "ConversationCreated": {
        "type": "object",
        "required": [
          "conversationId",
          "version",
          "ownership"
        ],
        "additionalProperties": false,
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "ownership": {
            "type": "string",
            "enum": [
              "AI"
            ]
          }
        }
      },
      "SubmitMessage": {
        "type": "object",
        "required": [
          "clientMessageId",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "clientMessageId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "MessageAccepted": {
        "type": "object",
        "required": [
          "messageId",
          "turnId",
          "status",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "messageId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "Pending"
          },
          "version": {
            "type": "integer",
            "minimum": 2
          }
        }
      },
      "PreviewCancellation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservationId"
        ],
        "properties": {
          "reservationId": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "ConfirmCancellation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offerId",
          "decision"
        ],
        "properties": {
          "offerId": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "confirm",
              "reject"
            ]
          }
        }
      },
      "AnswerFeedback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turnId",
          "reason"
        ],
        "properties": {
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "incorrect",
              "missing",
              "unclear"
            ]
          }
        }
      },
      "KnowledgeDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "version",
          "language",
          "topic",
          "sectionId",
          "title",
          "content",
          "classification",
          "expiresAt"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "description": "Must match KB-{TOPIC}-{LANGUAGE}"
          },
          "version": {
            "type": "integer",
            "minimum": 2
          },
          "language": {
            "type": "string",
            "enum": [
              "es",
              "en"
            ]
          },
          "topic": {
            "type": "string",
            "enum": [
              "cancellation",
              "services",
              "identity",
              "payments",
              "agent"
            ]
          },
          "sectionId": {
            "type": "string",
            "const": "overview"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "classification": {
            "type": "string",
            "enum": [
              "Public",
              "Agent"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "A new reviewed version of an existing registered document with matching tenant/language/topic; CP-001 text remains locked to canonical policy. No arbitrary document registration."
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ccai.demo.session",
        "description": "Opaque HttpOnly/Lax cookie with active SQLite session lookup; no saved tokens. Secure is disabled only for this synthetic HTTP loopback profile."
      },
      "AntiCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "Fetch GET /v1/session/csrf after every session rotation. Mutations also require exact HTTPS Origin."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-implementation": "local-demo-v0.8"
}
