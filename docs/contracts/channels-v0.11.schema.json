{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contactcenterai:channels:0.11",
  "title": "Neutral channel contracts v0.11",
  "description": "Provider DTOs are parsed in adapters. These envelopes carry routing data, not authenticated member authority.",
  "$defs": {
    "InboundText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "endpointId", "eventId", "senderId", "receivedAtUtc", "occurredAtUtc", "text"],
      "properties": {
        "version": {"const": "0.11"},
        "channel": {"enum": ["telegram", "whatsapp"]},
        "endpointId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
        "eventId": {"type": "string", "minLength": 1, "maxLength": 200},
        "senderId": {"type": "string", "pattern": "^[0-9]{1,20}$"},
        "receivedAtUtc": {"type": "string", "format": "date-time"},
        "occurredAtUtc": {"type": "string", "format": "date-time"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "Citation": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "version", "sectionId", "title"],
      "properties": {
        "documentId": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "integer", "minimum": 1},
        "sectionId": {"type": "string", "minLength": 1, "maxLength": 128},
        "title": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "PreparedReply": {
      "type": "object", "additionalProperties": false,
      "required": ["outboundId", "inboundKey", "epoch", "language", "reasonCode", "text", "citations"],
      "properties": {
        "outboundId": {"type": "string", "format": "uuid"},
        "inboundKey": {"type": "string", "minLength": 1, "maxLength": 300},
        "epoch": {"type": "integer", "minimum": 1},
        "language": {"enum": ["es", "en"]},
        "reasonCode": {"type": "string", "pattern": "^[A-Z_]{1,64}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 3500},
        "citations": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/Citation"}}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/InboundText"}, {"$ref": "#/$defs/PreparedReply"}]
}
